# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it contains your database password and login secret.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pathra?retryWrites=true&w=majority
PORT=4000

# Any long random string. Used to sign login tokens — if this leaks, an attacker could forge a
# logged-in session for any account, so keep it secret and don't reuse it elsewhere.
# Generate one quickly with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
